<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="tadami.extension" />

    <application android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:label="${appName}">
        <meta-data android:name="tadami.extension.class" android:value="${extClass}" />
        <!-- The repo the extension is built from, and the ID of each of its sources (";", extClass order).
             Read them with metaData.get(name)?.toString(): aapt2 stores a lone ID that fits an int as one -->
        <meta-data android:name="tadami.extension.repoId" android:value="${repoId}" />
        <meta-data android:name="tadami.extension.sourceIds" android:value="${sourceIds}" />
    </application>

</manifest>
